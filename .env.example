# ─────────────────────────────────────────────
# SCDE Frontend — Variables de entorno
# Copia este fichero a .env y ajusta los valores
# ─────────────────────────────────────────────

# Activar modo mock (sin backend real)
# true  → usa datos hardcoded y localStorage
# false → hace llamadas HTTP reales al backend
VITE_MOCK_API=true

# URL base del backend Django (sin trailing slash)
VITE_API_URL=http://localhost:8000
